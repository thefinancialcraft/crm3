    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter Attach (Remote Debugger)",
            "request": "attach",
            "type": "dart",
            "program": "lib/main.dart",
            "deviceId": "flutter-devices"
        },


        {
            "name": "crm3v2 - Copy",
            "request": "launch",
            "type": "dart"
        },
        {
            "name": "crm3v2 - Copy (profile mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "profile"
        },
        {
            "name": "crm3v2 - Copy (release mode)",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release"
        }
    ]
}